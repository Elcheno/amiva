# Copiar a .env y rellenar las contraseñas.

# Base core (usuarios, organizaciones, formularios...)
AMIVA_CORE_DB_URL=jdbc:postgresql://localhost:5432/amiva_core
AMIVA_CORE_DB_USER=amiva_core
AMIVA_CORE_DB_PASSWORD=

# Base data (submissions y respuestas)
AMIVA_DATA_DB_URL=jdbc:postgresql://localhost:5433/amiva_data
AMIVA_DATA_DB_USER=amiva_data
AMIVA_DATA_DB_PASSWORD=

# Email (en local, Mailpit del compose: bandeja en http://localhost:8025)
AMIVA_MAIL_HOST=localhost
AMIVA_MAIL_PORT=1025
AMIVA_MAIL_FROM=no-reply@amiva.local

# URL pública del front (enlaces de los emails)
AMIVA_APP_BASE_URL=http://localhost:5173
